<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground. All artwork sits inside the centre 72x72 of the 108x108
  viewport so no part of it is cropped by a launcher's mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Upper and lower frame caps -->
    <path
        android:fillColor="@color/icon_sand"
        android:pathData="M33,24h42a3,3 0 0 1 0,6h-42a3,3 0 0 1 0,-6z" />
    <path
        android:fillColor="@color/icon_sand"
        android:pathData="M33,78h42a3,3 0 0 1 0,6h-42a3,3 0 0 1 0,-6z" />

    <!-- Glass: upper chamber drained, lower chamber heaped -->
    <path
        android:fillColor="@color/icon_sand"
        android:fillAlpha="0.45"
        android:pathData="M38,30L70,30L57,54L70,78L38,78L51,54Z" />

    <!-- Sand: the stream and the mound -->
    <path
        android:fillColor="@color/icon_sand"
        android:pathData="M52.6,52h2.8v14h-2.8z" />
    <path
        android:fillColor="@color/icon_sand"
        android:pathData="M38,78L70,78L62,66Q54,60 46,66Z" />
    <path
        android:fillColor="@color/icon_sand"
        android:fillAlpha="0.8"
        android:pathData="M38,30L70,30L64,41L44,41Z" />
</vector>
